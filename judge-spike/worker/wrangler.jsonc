{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Phase 1 judge spike: runs the probe suite against a real Cloudflare Container (ARCHITECTURE §5.7).
  "name": "kingcoda-judge-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "JudgeBox",
      "image": "../Dockerfile",
      "image_build_context": "..",
      // Matches the planned production box: 1 vCPU, 3 GiB.
      "instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 8000 },
      "max_instances": 2,
    },
  ],
  "durable_objects": { "bindings": [{ "name": "JUDGE_BOX", "class_name": "JudgeBox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JudgeBox"] }],
}
