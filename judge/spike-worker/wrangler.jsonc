{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Phase 1 judge spike: runs the probe suite against a real Cloudflare Container (ARCHITECTURE §5.7).
  // New accounts only get the durable_object scheduling policy, so the Durable Object starts the box itself.
  "name": "kingcoda-judge-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "JudgeBox",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "../Dockerfile", "build_context": ".." } },
    },
  ],
  "durable_objects": { "bindings": [{ "name": "JUDGE_BOX", "class_name": "JudgeBox" }] },
  "exports": { "JudgeBox": { "type": "durable-object", "storage": "sqlite" } },
}
