{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kingcoda-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "local", "BETTER_AUTH_URL": "http://localhost:3000" },
  // Local dev uses Miniflare's emulated D1/KV/R2; ids below are placeholders until D9 (Cloudflare account) lands.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kingcoda-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "CODE", "bucket_name": "kingcoda-code-local" }],
  // The judge Worker's RPC entrypoint (apps/judge). Locally, run `pnpm --filter @kingcoda/judge dev` too.
  "services": [{ "binding": "JUDGE", "service": "kingcoda-judge" }],
  "ratelimits": [
    { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "RUN_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
  ],
  "env": {
    // Playwright only (KC_E2E=1): local emulated bindings plus the test-only password sign-in switch.
    "e2e": {
      "vars": {
        "APP_ENV": "local",
        "BETTER_AUTH_URL": "http://localhost:3100",
        "E2E_PASSWORD_AUTH": "1",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kingcoda-e2e",
          "database_id": "00000000-0000-0000-0000-0000000000e2",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "000000000000000000000000000000e2" }],
      "r2_buckets": [{ "binding": "CODE", "bucket_name": "kingcoda-code-e2e" }],
      "services": [{ "binding": "JUDGE", "service": "kingcoda-judge-e2e" }],
      "ratelimits": [
        { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
        { "name": "RUN_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
      ],
    },
    "staging": {
      "name": "kingcoda-web-staging",
      "vars": {
        "APP_ENV": "staging",
        "BETTER_AUTH_URL": "https://kingcoda-web-staging.gaven-robertson.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kingcoda-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "REPLACE_WITH_STAGING_KV_ID" }],
      "r2_buckets": [{ "binding": "CODE", "bucket_name": "kingcoda-code-staging" }],
      "services": [{ "binding": "JUDGE", "service": "kingcoda-judge-staging" }],
      "ratelimits": [
        { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
        { "name": "RUN_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
      ],
    },
    "production": {
      "name": "kingcoda-web",
      "vars": {
        "APP_ENV": "production",
        "BETTER_AUTH_URL": "https://kingcoda-web.gaven-robertson.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kingcoda",
          "database_id": "eb5a699b-562a-4750-83f9-9b63d9d95eec",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "e488b105be32480db51efee987f1d641" }],
      "r2_buckets": [{ "binding": "CODE", "bucket_name": "kingcoda-code" }],
      "services": [{ "binding": "JUDGE", "service": "kingcoda-judge" }],
      "ratelimits": [
        { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
        { "name": "RUN_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
      ],
    },
  },
}
